{
  // Một Worker duy nhất: giao diện (static assets) + API + email() handler.
  // Secrets (KHÔNG ghi ở đây — đặt bằng `wrangler secret put`):
  //   RESEND_API_KEY   — key Resend 'vn-stock-ai' (sending-only)
  //   SESSION_SECRET   — chuỗi ngẫu nhiên >= 32 byte để ký cookie phiên
  //   TOTP_ENCRYPTION_KEY   — khóa mã hóa TOTP secret (đặt qua wrangler secret tại deploy, local dev dùng .dev.vars)
  //   VAPID_PRIVATE_KEY   — khóa bí mật VAPID (JWK private ES256) cho Web Push
  //   VAPID_PUBLIC_KEY    — khóa công khai VAPID cho Web Push (vars hoặc secret)
  //   TELEGRAM_BOT_TOKEN  — token bot Telegram riêng của webmail (tạo qua @BotFather)
  "name": "aistockvn-mail",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "mail.aistockvn.com", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  // Observability guardrail (từ 1/12/2026 Cloudflare tính tiền log/trace theo GB;
  // Free: 0,5 GB/ngày). Chỉ lấy mẫu 10% log/trace để trần ingestion thấp.
  // Lỗi thật vẫn còn trong D1 (ingest_failures / client_errors / backup_runs)
  // nên không mất khả năng nhìn thấy lỗi. KHÔNG tắt log hẳn.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aistockvn-mail",
      // Thay bằng id thật in ra từ `wrangler d1 create aistockvn-mail`.
      "database_id": "1accd00a-78dc-445b-ada2-52941f14bdbc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "aistockvn-mail-raw" },
    { "binding": "BACKUP", "bucket_name": "aistockvn-mail-backup" }
  ],
  "workflows": [
    {
      "name": "aistockvn-mail-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "BackupWorkflow"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "MAILBOX_ADDRESS": "admin@aistockvn.com",
    "FROM_NAME": "AI Stock VN",
    // Email được phép đăng nhập (phân cách bằng dấu phẩy).
    "ALLOWED_EMAILS": "tranbinhanbr01@gmail.com,lethanhdongus@gmail.com,admin@aistockvn.com",
    // OAuth Client ID (Web) của Google — công khai, không phải secret.
    "GOOGLE_CLIENT_ID": "805905019378-3np2mee228hp7lpfpju7psjnvqde1ao2.apps.googleusercontent.com",
    // Giữ nguyên forward hiện tại: đích phải là địa chỉ đã xác minh trong Email Routing.
    "FORWARD_TO": "skillshare01br@mail.com"
  }
}
